diff --git a/src/providers/baton.ts b/src/providers/baton.ts
new file mode 100644
index 0000000..c46ecc7
--- /dev/null
+++ b/src/providers/baton.ts
@@ -0,0 +1,30 @@
+import type { ProviderClient, ProviderSession } from "../types.js";
+import { requireEnv } from "../utils/env.js";
+import { Baton, type Session } from "batonvm";
+
+export class BatonProvider implements ProviderClient {
+  readonly name = "BATON";
+  private _client: Baton | null = null;
+  private sessions = new Map<string, Session>();
+
+  private client(): Baton {
+    if (!this._client) {
+      this._client = new Baton({ apiKey: requireEnv("BATON_API_KEY") });
+    }
+    return this._client;
+  }
+
+  async create(): Promise<ProviderSession> {
+    const session = await this.client().sessions.create();
+    if (!session?.id || !session.connectUrl)
+      throw new Error("Invalid Baton session response");
+    this.sessions.set(session.id, session);
+    return { id: session.id, cdpUrl: session.connectUrl };
+  }
+
+  async release(id: string): Promise<void> {
+    const session = this.sessions.get(id);
+    this.sessions.delete(id);
+    if (session) await session.close();
+  }
+}

{
  "name": "batonvm",
  "version": "0.1.0",
  "description": "Cloud browsers for agents that keep running while they move between machines",
  "license": "MIT",
  "homepage": "https://batonvm.vercel.app",
  "keywords": ["browser", "playwright", "puppeteer", "cdp", "agents", "firecracker"],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json"
  },
  "devDependencies": { "typescript": "^5.6.0" }
}
